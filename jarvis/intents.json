      "utilisation du processeur", "utilisation de la memoire", "combien de ram",
      "etat de la carte graphique", "temperature du gpu", "espace disque"
    ]
  },
  {
    "tool": "list_processes",
    "phrases": [
      "liste des processus", "liste les processus", "processus en cours",
      "quels programmes tournent", "qu est ce qui tourne"
    ]
  },
  {
    "tool": "search_files",
    "patterns": [
      "(cherche|trouve|recherche) (le |les |un |des )?(fichiers? )?{name} dans (le dossier |mes |les |mon )?{folder}",
      "(cherche|trouve|recherche) (le |les |un |des )?fichiers? {name}"
    ],
    "defaults": {"folder": "~"},
    "choices": {"folder": ["documents", "telechargements", "images", "photos", "bureau", "musique", "videos"]}
  },
  {
    "tool": "set_volume",
    "patterns": ["((mets|met|r[eéè]gle) )?(le )?(volume|son) (à|a|sur|au) {level} ?(%|pour ?cent)?"]
  },
  {
