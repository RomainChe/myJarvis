[
  {
    "tool": "system_status",
    "phrases": [
      "etat du systeme", "etat du pc", "statut du pc", "comment va le pc",
      "utilisation du processeur", "utilisation de la memoire", "combien de ram",
      "etat de la carte graphique", "temperature du gpu", "espace disque"
    ]
  },
  {
    "tool": "list_processes",
    "phrases": [
      "liste des processus", "liste les processus", "processus en cours",
      "quels programmes tournent", "qu est ce qui tourne"
    ]
  },
  {
    "tool": "search_files",
    "patterns": [
      "(cherche|trouve|recherche) (le |les |un |des )?(fichiers? )?{name} dans (le dossier |mes |les |mon )?{folder}",
      "(cherche|trouve|recherche) (le |les |un |des )?fichiers? {name}"
    ],
    "defaults": {"folder": "~"},
    "choices": {"folder": ["documents", "telechargements", "images", "photos", "bureau", "musique", "videos"]}
  },
  {
    "tool": "set_volume",
    "patterns": ["((mets|met|r[eéè]gle|monte|baisse|augmente|diminue) )?(le )?(volume|son) (à|a|sur|au) {level} ?(%|pour ?cent)?"]
  },
  {
    "tool": "mute",
    "patterns": ["(coupe|couper) (le )?(son|volume)( du pc)?", "sourdine|mute", "(mets|met) (le pc )?en sourdine"],
    "defaults": {"muted": true}
  },
  {
    "tool": "mute",
    "patterns": ["(remets|remet|r[eé]tablis|r[eé]active|active) (le )?(son|volume)", "(d[eé]sactive|enl[eè]ve) (la )?sourdine|unmute"],
    "defaults": {"muted": false}
  },
  {
    "tool": "media_control",
    "patterns": ["((mets|met|remets|remet) )?(la )?(pause|lecture)|play|reprends( la lecture)?|(mets|met) en pause"],
    "defaults": {"action": "play_pause"}
  },
  {
    "tool": "media_control",
    "patterns": ["((passe|saute)( au| le| à la| a la)? )?((morceau|titre|piste|chanson|musique) )?suivante?|next"],
    "defaults": {"action": "next"}
  },
  {
    "tool": "media_control",
    "patterns": ["((reviens|retourne|passe)( au| le| à la| a la)? )?((morceau|titre|piste|chanson|musique) )?pr[eé]c[eé]dente?|previous"],
    "defaults": {"action": "previous"}
  },
  {
    "tool": "lock_session",
    "patterns": ["verrouille(r)?( (ma|la) session| (le|mon) pc| l['’]ordinateur| l['’ ]?[eé]cran)?"]
  },
  {
    "tool": "screen_off",
    "patterns": ["([eé]teins|[eé]teindre|coupe|couper) l['’ ]?[eé]cran( du pc)?", "(mets|met) l['’ ]?[eé]cran en veille"]
  },
  {
    "tool": "tv_on",
    "patterns": ["(allume|allumer) la (tv|t[ée]l[ée]|t[ée]l[ée]vision)( du salon)?"]
  },
  {
    "tool": "tv_off",
    "patterns": ["([eé]teins|[eé]teindre) la (tv|t[ée]l[ée]|t[ée]l[ée]vision)( du salon)?"]
  },
  {
    "tool": "tv_status",
    "phrases": ["la tele est allumee", "etat de la tv", "etat de la tele"]
  },
  {
    "tool": "scene_cinema",
    "patterns": [
      "(mets|met|lance|active|passe en) (le )?mode cin[eé]ma",
      "(mets|met|lance|active|passe en) (le )?mode cin[eé]ma (sur|avec) {app}"
    ],
    "defaults": {"app": ""},
    "choices": {"app": ["youtube", "netflix", "twitch", "spotify"]}
  },
  {
    "tool": "claude_code",
    "patterns": [
      "(code|(modifie|change|am[eé]liore) ton code|ajoute (à|a|dans) ton code) ?: ?{request}",
      "((modifie|change|am[eé]liore) ton code|ajoute (à|a|dans) ton code)( pour)? {request}"
    ]
  },
  {
    "tool": "claude_code_status",
    "phrases": ["ou en est le code", "resultat du code", "compte rendu du code", "etat du code"]
  }
]
