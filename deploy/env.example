# Copier vers ~/.config/jarvis/env sur le mini-PC (chmod 600). Aucun secret ici : voir deploy/creds.sh.
JARVIS_TS_HOST=
JARVIS_OLLAMA_URL=
JARVIS_AGENT_URL=
JARVIS_HA_URL=
JARVIS_PUSH_CONTACT=
# Seuil « PC éteint » de la prise (W, 5 à 100, défaut 10) : 3 × la veille mesurée
JARVIS_PC_IDLE_W=
# Sauvegarde : un autre disque ou une autre machine (D1), jamais ~/.jarvis
JARVIS_BACKUP_DIR=
