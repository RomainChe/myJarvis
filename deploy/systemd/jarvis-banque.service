[Unit]
Description=JARVIS récupération bancaire quotidienne (lecture seule)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/jarvis
EnvironmentFile=-%h/.config/jarvis/env
ExecStart=%h/jarvis/deploy/creds.sh run %h/venv/bin/python -m jarvis bank fetch daily
NoNewPrivileges=yes
PrivateTmp=yes
