[Unit]
Description=JARVIS Core (serveur, PWA, routeur, domotique)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/jarvis
EnvironmentFile=-%h/.config/jarvis/env
ExecStart=%h/jarvis/deploy/creds.sh run %h/venv/bin/python -m jarvis serve
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=default.target
