# Chemin de la base SQLite (audit + mémoire). Défaut : ~/.jarvis/jarvis.db
JARVIS_DB=
# Port du serveur local de la PWA (1024-65535)
JARVIS_PORT=
# Nom exact de ce PC sur le tailnet (xxx.tailnet.ts.net, minuscules). Hors dépôt.
JARVIS_TS_HOST=
# Contact VAPID des notifications (mailto:... ou https://...). Hors dépôt. Défaut neutre.
# Il est envoyé à Google, Mozilla ou Apple : jamais d'adresse personnelle (RGPD), une adresse dédiée au besoin.
JARVIS_PUSH_CONTACT=
# Sortie audio de la voix (nom ou index sounddevice). Vide = sortie par défaut. Hors dépôt.
JARVIS_AUDIO_OUT=
# Voix de Jarvis : tom (défaut), gilles ou pierre. Débit 0.8-1.6 (> 1 = plus lent, défaut 1.05). Effet « IA » : 0 le coupe.
JARVIS_VOICE=
JARVIS_VOICE_RATE=
JARVIS_VOICE_FX=
# Briefing du matin automatique (voix du PC + notification), heure locale HH:MM. Vide = pas de briefing automatique.
JARVIS_BRIEFING_AT=
# Mot de réveil : hey_jarvis_v0.1 (défaut) ou jarvis_fr (modèle maison). Seuil 0.2-0.95 (défaut 0.5).
JARVIS_WAKE_WORD=
JARVIS_WAKE_THRESHOLD=
# Core sur le mini-PC : URL d'Ollama et de l'agent PC (boucle locale, IP Tailscale ou *.ts.net seulement).
JARVIS_OLLAMA_URL=
JARVIS_AGENT_URL=
# Sur le PC (agent) : adresse Tailscale d'écoute et port (8788 par défaut). Clé : `python -m jarvis secret set agent_key`.
JARVIS_AGENT_HOST=
JARVIS_AGENT_PORT=
