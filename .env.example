# Chemin de la base SQLite (audit + mémoire). Défaut : ~/.jarvis/jarvis.db
JARVIS_DB=
# Port du serveur local de la PWA (1024-65535)
JARVIS_PORT=
# Nom exact de ce PC sur le tailnet (xxx.tailnet.ts.net, minuscules). Hors dépôt.
JARVIS_TS_HOST=
# Contact VAPID des notifications (mailto:... ou https://...). Hors dépôt. Défaut neutre.
# Il est envoyé à Google, Mozilla ou Apple : jamais d'adresse personnelle (RGPD), une adresse dédiée au besoin.
JARVIS_PUSH_CONTACT=
# Sortie audio de la voix (nom ou index sounddevice). Vide = sortie par défaut. Hors dépôt.
JARVIS_AUDIO_OUT=
# Voix de Jarvis : tom (défaut), gilles ou pierre. Débit 0.8-1.6 (> 1 = plus lent, défaut 1.05). Effet « IA » : 0 le coupe.
JARVIS_VOICE=
JARVIS_VOICE_RATE=
JARVIS_VOICE_FX=
