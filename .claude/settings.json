{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "if": "Bash(git commit *)", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde_branches.py\"", "timeout": 30, "statusMessage": "Garde des branches…" },
          { "type": "command", "if": "Bash(git merge *)", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde_branches.py\"", "timeout": 30, "statusMessage": "Garde des branches…" },
          { "type": "command", "if": "Bash(git push *)", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde_branches.py\"", "timeout": 30, "statusMessage": "Garde des branches…" },
          { "type": "command", "if": "PowerShell(git commit *)", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde_branches.py\"", "timeout": 30, "statusMessage": "Garde des branches…" },
          { "type": "command", "if": "PowerShell(git merge *)", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde_branches.py\"", "timeout": 30, "statusMessage": "Garde des branches…" },
          { "type": "command", "if": "PowerShell(git push *)", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde_branches.py\"", "timeout": 30, "statusMessage": "Garde des branches…" }
        ]
      }
    ]
  }
}
